{
    default_sni {$SERVER_IP}
}

(superkiro_routes) {
    redir /admin /admin/ 308
    redir /portal /device 308
    redir /portal/ /device 308

    @public_pages {
        method GET HEAD
        path / /device /device/* /docs /docs/*
    }
    handle @public_pages {
        root * /app/portal-ui
        rewrite * /index.html
        file_server
        header Cache-Control "no-store"
    }

    handle /downloads/releases.json {
        root * /app/downloads
        rewrite * /releases.json
        file_server
        header Cache-Control "no-store"
    }

    handle_path /downloads/* {
        root * /app/downloads
        file_server
        header Cache-Control "public, max-age=300"
        header X-Content-Type-Options "nosniff"
    }

    handle_path /admin/* {
        # Public login shell only; never add a Basic challenge here.
        # Gateway requires ADMIN_BROWSER_LOGIN=true + ADMIN_ORIGIN + ADMIN_PASSWORD_HASH
        # and fails closed when browser authentication is not configured.
        root * /app/admin-ui
        try_files {path} /index.html
        file_server
        header Cache-Control "no-store"
    }

    handle {
        reverse_proxy gateway:19820 {
            flush_interval -1
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    encode gzip zstd
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    log {
        output stdout
        format json
    }
}

kiro.rent {
    import superkiro_routes
}

# Compatibility for existing installed clients. New packages use public domain TLS.
https://{$SERVER_IP} {
    tls internal
    import superkiro_routes
}

