# ==============================================================================
# Kiro BYOK 单机一体化环境变量配置模板
# ==============================================================================

# 1. 域名与安全配置 (用于 Caddy 自动申请 HTTPS 证书与接口鉴权)
DOMAIN=kiro.example.com
AUTH_SECRET=generate-a-secure-random-string-at-least-32-chars-long!
# 独立管理端密钥，必须与 AUTH_SECRET 不同
ADMIN_KEY=generate-a-different-admin-secret-at-least-32-chars!
# 管理后台表单登录（由 gateway 验证，不是 Caddy Basic Auth）
# 任一配置缺失/无效时启动失败，不回退 raw ADMIN_KEY 登录。
ADMIN_BROWSER_LOGIN=true
ADMIN_ORIGIN=https://kiro.example.com
# 使用单引号保留 bcrypt 中的 $；替换占位值后才能启动，禁止填写明文。
ADMIN_PASSWORD_HASH='$2a$12$replace-with-a-real-bcrypt-hash'
# 可选 TOTP 第二因素：大写 Base32 种子，至少 20 字节随机熵；不配置时禁用。
# ADMIN_TOTP_SECRET=<Base32 seed from secure enrollment>
# 账务快照加密主密钥，生产环境必填
KIRO_MASTER_KEK=replace-with-64-random-hex-characters
# 发卡平台对接安全密钥 (用于保护 /api/v1/cards/* 接口防止未授权刷卡)
CARD_PLATFORM_KEY=secret-card-platform-token-here

# 2. 上游大模型服务商配置 (支持 openai / anthropic)
PROVIDER_TYPE=openai
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=sk-your-upstream-api-key-here
UPSTREAM_MODEL=deepseek-chat

# Experimental image-to-text fallback. Disabled by default.
# Vision subrequest costs are NOT included in card billing; keep disabled in production.
# VISION_FALLBACK_API_KEY=replace-me
# VISION_FALLBACK_BASE_URL=https://api.openai.com
# VISION_FALLBACK_MODEL=gpt-4o-mini
# VISION_FALLBACK_ENABLED=false
# VISION_FALLBACK_MAX_TOKENS=1024

# 3. 可选一次性引导卡。生产默认不创建示例卡，在管理后台生成卡密。
# DEV_CARD_CODE=<16..256 characters, securely generated>

# 4. 品牌与客户端白标名称
BRAND_NAME=Superkiro
CREDIT_LABEL=积分

# 5. 可信反代网段与账务快照安全 (Spec §7, P1-04)
TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.1/32,10.0.0.0/8
TRUSTED_PROXY_HEADERS=true
REQUIRE_ENCRYPTED_SNAPSHOTS=true

