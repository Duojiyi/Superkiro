{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Superkiro",
  "version": "0.1.3",
  "identifier": "app.superkiro.desktop",
  "build": {
    "frontendDist": "../../apps/desktop-ui/dist",
    "beforeBuildCommand": "npm --prefix ../apps/desktop-ui run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Superkiro",
        "width": 480,
        "height": 540,
        "minWidth": 480,
        "minHeight": 540,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "desktop-local",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:window:allow-start-dragging",
            "core:window:allow-internal-toggle-maximize"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
